# ==============================================================================
# CrimeNexus Backend Environment Variables Template
# Copy this file to `backend/.env` for local development and fill in your keys.
# ==============================================================================
ENVIRONMENT=development
SECRET_KEY=your_secret_key_here

# Pipeline 1: Crime Risk Prediction QuickML Endpoint
QUICKML_CRIME_RISK_ENDPOINT=https://api.catalyst.zoho.in/quickml/v1/project/47004000000181026/endpoints/predict
QUICKML_API_KEY=YOUR_QUICKML_API_KEY_HERE

# Pipeline 2: Future Hotspot Prediction QuickML Endpoint
QUICKML_HOTSPOT_ENDPOINT=https://api.catalyst.zoho.in/quickml/v1/project/47004000000181026/endpoints/predict
QUICKML_HOTSPOT_API_KEY=YOUR_QUICKML_HOTSPOT_API_KEY_HERE

# Pipeline 3: Repeat Offender Recidivism Prediction QuickML Endpoint
QUICKML_OFFENDER_ENDPOINT=https://api.catalyst.zoho.in/quickml/v1/project/47004000000181026/endpoints/predict?explainModel=true
QUICKML_OFFENDER_API_KEY=YOUR_QUICKML_OFFENDER_API_KEY_HERE

# Zoho Catalyst Organization & Environment
QUICKML_CATALYST_ORG=60073631382
QUICKML_ENVIRONMENT=Development

# Zoho OAuth Credentials
ZOHO_CLIENT_ID=YOUR_ZOHO_CLIENT_ID_HERE
ZOHO_CLIENT_SECRET=YOUR_ZOHO_CLIENT_SECRET_HERE
ZOHO_GRANT_TOKEN=YOUR_ZOHO_GRANT_TOKEN_HERE
ZOHO_ACCESS_TOKEN=YOUR_ZOHO_ACCESS_TOKEN_HERE
ZOHO_REFRESH_TOKEN=YOUR_ZOHO_REFRESH_TOKEN_HERE
